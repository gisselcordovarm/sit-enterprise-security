# Configuración Supabase (despliegue de prueba)
# 1. Crea un proyecto en https://supabase.com
# 2. En Project Settings > API, copia la URL del proyecto y la anon key.
# 3. Ejecuta el contenido de supabase/schema.sql en el SQL Editor.
# 4. Copia este archivo a .env.local y completa los valores.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU-ANON-KEY

# SEGURIDAD: habilita el ingreso de respaldo "cualquier correo" (derivando el rol
# del email) cuando Supabase no autentica. Omitido o 'false' en producción: el
# login exige credenciales reales contra Supabase Auth.
# VITE_ENABLE_DEMO_FALLBACK=true

# --- INVITACIÓN DE USUARIOS (solo servidor, NUNCA con prefijo VITE_ ni en el cliente) ---
# Clave `service_role` de Supabase. La usa la función serverless /api/invite
# para crear usuarios con token de invitación (correo de activación). Configurarla
# SOLO como variable de entorno de Vercel (Production), no en .env.local.
# SUPABASE_SERVICE_ROLE_KEY=TU-SERVICE-ROLE-KEY
# SITE_URL=https://TU-DOMINIO.vercel.app

# --- CORREO DE ACTIVACIÓN (Mailtrap Sending API) ---
# Token de la API de Mailtrap (https://send.api.mailtrap.io/api/send). Sin esto,
# la invitación igual funciona pero el enlace se entrega al admin para reenviar.
# MAILTRAP_API_TOKEN=TU-MAILTRAP-TOKEN
# MAILTRAP_FROM_EMAIL=no-reply@tecnoinnova.vercel.app
# MAILTRAP_FROM_NAME=SIT · TecnoInnova
